LD_HOME         = $(HOME)/Project
CC              = gcc
CPP             = g++

#────🔵 for MAC ──────────────────────
#CC              = icc
#────🔵 for Motif ────────────────────
UIL             = uil
#────🔵 ORACEL PRO-C ─────────────────
PROC            = 

COMMON_INCL     = -I$(LD_HOME)/cominclude
LOCAL_INCL      = -I$(LD_HOME)/include
INCLUDE         = $(LOCAL_INCL) $(COMMON_INCL)

COMMON_LIB_PATH = -L$(LD_HOME)/comlib
LOCAL_LIB_PATH  = -L$(LD_HOME)/lib
LIB_PATH        = $(COMMON_LIB_PATH) $(LOCAL_LIB_PATH)

#	┌────────────────────────────────────────────────────┐
#	│ about LOGOUT_TYPE                                  │
#	├────┬───────────────────────────────────────────────┤
#	│  1 │ ZeroMQ non-thread version (Logman0mq)         │
#	│ 11 │ ZeroMQ thread version     (Logman0mq)         │
#	│  0 │ Stand alone               (필요없음)          │
#	│  2 │ Multicasting Version      (LogmanMt)          │
#	└────┴───────────────────────────────────────────────┘

CFLAGS          = -O3 -g -DLOGOUT_TYPE=1 -c $(INCLUDE)
#CFLAGS          = -O3 -no-prec-div -static -xHost -g -c $(INCLUDE)
PROCFLAGS       =

LOCAL_LIBS      = 
COMMON_LIBS     =
DB_LIBS         =
SYS_LIBS        =
LIBS            = $(LOCAL_LIBS) $(COMMON_LIBS) $(RDB_LIBS) $(SYS_LIBS)

.SUFFIXES       : .cc .c .o .pc .uil .uid

.c.o            :
	$(CC) $(CFLAGS) $*.c
.cc.o            :
	$(CPP) $(CFLAGS) $*.cc

#────🔵 ORACEL PRO-C ─────────────
.pc.c	:
	$(PROC) $(PROCFLAGS) iname=$*
.pc.o	:
	$(PROC) $(PROCFLAGS) iname=$*
	$(CC) $(CFLAGS) $*.cc
#────🔵 for X-WINDOW(Motif) UIL ──
.uil.uid        :
	$(UIL) -o $*.uid $*.uil

TARGET         = tipcGrcv tipcGsnd tipcGsnd2

all  :  $(TARGET)

tipcGsnd : tipcGsnd.o
	$(CC) -o $@ tipcGsnd.o $(LIB_PATH) $(LIBS)
tipcGsnd2 : tipcGsnd2.o
	$(CC) -o $@ tipcGsnd2.o $(LIB_PATH) $(LIBS)
tipcGrcv : tipcGrcv.o
	$(CC) -o $@ tipcGrcv.o $(LIB_PATH) $(LIBS)

install : $(TARGET)
	@strip $(TARGET)
	cp $(TARGET) $(LD_HOME)/bin
	make clean

clean           :
	 rm -f $(TARGET) *.o core
